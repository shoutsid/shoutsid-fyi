<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Blog — <%= profile["name"] %></title>
  <subtitle><%= profile.dig("site", "description").to_s.gsub(/\s+/, " ").strip %></subtitle>
  <link href="<%= site_url %>/blog/feed.xml" rel="self"/>
  <link href="<%= site_url %>/blog"/>
  <updated><%= @posts.first&.iso_date || Date.today.strftime("%Y-%m-%d") %>T00:00:00Z</updated>
  <id><%= site_url %>/blog</id>
  <author>
    <name><%= profile["name"] %></name>
    <email><%= profile["email"] %></email>
  </author>
<% @posts.each do |post| %>
  <entry>
    <title><%= post.title %></title>
    <link href="<%= site_url %><%= post.url %>"/>
    <id><%= site_url %><%= post.url %></id>
    <updated><%= post.iso_date %>T00:00:00Z</updated>
    <summary><%= post.summary.to_s.gsub(/\s+/, " ").strip %></summary>
<% post.tags.each do |tag| %>
    <category term="<%= tag %>"/>
<% end %>
  </entry>
<% end %>
</feed>
