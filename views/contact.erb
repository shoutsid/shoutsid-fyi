<header class="page-head">
  <p class="eyebrow">Contact</p>
  <h1>Get in touch</h1>
  <p class="lede"><%= profile["seeking"] %></p>
</header>

<section class="section">
  <ul class="contact-list">
    <% profile_links.each do |link| %>
      <li class="contact-item">
        <% if external_link?(link["url"]) %>
          <a href="<%= link["url"] %>" target="_blank" rel="noopener noreferrer">
            <span class="contact-label"><%= link["label"] %></span>
            <span class="contact-value"><%= link["url"].sub(%r{\Ahttps?://}, "") %></span>
          </a>
        <% else %>
          <a href="<%= link["url"] %>">
            <span class="contact-label"><%= link["label"] %></span>
            <span class="contact-value"><%= link["url"].sub("mailto:", "") %></span>
          </a>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>

<section class="section" aria-labelledby="based-heading">
  <div class="section-head">
    <h2 id="based-heading">Where</h2>
  </div>
  <p class="prose">
    Based in <%= profile["location"] %>.
    <%= page_copy("contact", "where_note") %>
  </p>
</section>
