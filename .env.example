# Copy to `.env` before the first deploy: `bin/site setup` does exactly that
# copy. Nothing here is a secret except CF_TUNNEL_TOKEN.
#
# docker-compose.tunnel.yml marks CF_TUNNEL_TOKEN with `:?`, so the tunnel
# service refuses to start rather than coming up without an ingress. It is not
# the base file, deliberately: Compose interpolates a whole file before applying
# profiles, so a required variable there would make *every* command fail until
# the tunnel had been provisioned — including `docker compose build`.

# Where the app is reachable from the host. Bound to loopback only — the
# public path is the Cloudflare Tunnel, so this port should not be exposed.
#
# 3010 rather than Sinatra's 4567 or the more usual 3000: this host already
# runs Gitea on 3000, and `docker compose up` failing with "port is already
# allocated" is a worse first-run experience than remembering a different
# number. It only has to be free on the host — inside the container the app
# always listens on 3000.
HOST_PORT=3010

# Port for `bin/site dev`; content and templates reload on the next request.
DEV_PORT=3011

# Reported by GET /healthz and printed by `bin/site version`. The app reads it
# from the environment rather than carrying a literal, so this line is the only
# place the number is chosen; app.rb and bin/site name the same default, and
# spec/harness_spec.rb fails if the three ever disagree.
APP_VERSION=0.1.0

# Written by `bin/cf-setup.sh`, which creates the tunnel through the Cloudflare
# API and appends the token here. A remotely-managed tunnel: the ingress rules
# live in Cloudflare, so this one value is the whole edge configuration.
CF_TUNNEL_TOKEN=

# Puma threads inside the container.
PUMA_THREADS=5
